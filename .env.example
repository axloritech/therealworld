# ─────────────────────────────────────────────────────────────────────────────
# THE REAL WORLD — demo trading platform
# Copy this file to `.env.local` and fill in what you have.
# EVERYTHING HERE IS OPTIONAL: with no keys the app runs in local DEMO MODE
# (file-backed sandbox database) so you can click through the whole product.
# Add the Supabase keys to switch the exact same UI onto a real database.
# ─────────────────────────────────────────────────────────────────────────────

# ── Branding ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="The Real World"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Logo slots default to /logo.png — the circular transparent brand mark shipped
# at public/logo.png fills every slot (header, footer, auth pages). Swap the
# file or override with any URL here to use your own art.
NEXT_PUBLIC_LOGO_URL=""
NEXT_PUBLIC_LOGO_MARK_URL=""

# ── Videos ──────────────────────────────────────────────────────────────────
# Hero film: a Vimeo URL / numeric Vimeo ID, or a YouTube ID / youtu.be / watch URL.
# Defaults to the owner's Vimeo cut; set empty to show the reserved video slot.
NEXT_PUBLIC_HERO_VIDEO="https://vimeo.com/902932460"
# Second film (Market analysis section): same accepted formats.
NEXT_PUBLIC_MARKET_VIDEO="https://youtu.be/yLMO2F7r01E"
NEXT_PUBLIC_YOUTUBE_TITLE="The Real World — platform overview"

# ── Supabase (add these to go live) ─────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Comma-separated list of addresses that are auto-promoted to admin on sign-up.
ADMIN_EMAILS=""

# ── Demo mode only ──────────────────────────────────────────────────────────
# Secret used to sign local demo sessions. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_AUTH_SECRET=""
# Where the local sandbox database lives (defaults to ./.data/demo-db.json).
# On read-only hosts this automatically falls back to the OS temp directory.
DEMO_DB_PATH=""

# Seed the sandbox with demo users/threads/withdrawals on first boot.
DEMO_SEED="true"
